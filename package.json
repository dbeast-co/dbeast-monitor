{
  "name": "dbeast-monitor-app",
  "version": "2.1.1",
  "description": "DBeast Monitoring toolkit for Elastic Stack",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "build_and_mage": "webpack -c ./.config/webpack/webpack.config.ts --env production &&  c:\\app\\mage\\mage -v",
    "build_and_mage:mac": "webpack -c ./.config/webpack/webpack.config.ts --env production &&  mage -v",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "e2e": "playwright test",
    "server": "docker compose up --build",
    "mage_win": "c:\\app\\mage\\mage -v",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "DBeast",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.x",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.x",
    "@babel/preset-typescript": "^7.x",
    "@grafana/eslint-config": "^8.0.0",
    "@grafana/plugin-e2e": "^2.0.6",
    "@grafana/tsconfig": "^2.0.0",
    "@playwright/test": "^1.56.1",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.8.7",
    "@types/testing-library__jest-dom": "5.14.8",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "ajv": "8.20.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-jsdoc": "^46.8.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-webpack-plugin": "^4.0.1",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.2.7",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "semver": "^7.6.3",
    "style-loader": "3.3.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "12.3.6",
    "@grafana/runtime": "12.3.6",
    "@grafana/schema": "12.3.6",
    "@grafana/ui": "12.3.6",
    "file-saver": "^2.0.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.30.6",
    "react-toastify": "^11.0.5",
    "rxjs": "7.8.1"
  },
  "overrides": {
    "@grafana/faro-core": "2.11.0",
    "@grafana/faro-web-sdk": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.9",
    "fast-uri": "4.1.4",
    "immutable": "5.1.9",
    "js-cookie": "3.0.8",
    "js-yaml": "5.4.1",
    "lodash": "4.18.1",
    "minimatch": "10.2.6",
    "nanoid": "6.0.1",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "prismjs": "1.30.0",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "uuid": "14.0.2"
  },
  "packageManager": "npm@9.2.0"
}
